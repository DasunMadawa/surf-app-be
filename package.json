{
  "name": "stara-middleware",
  "version": "1.0.0",
  "private": true,
  "description": "Stara booking middleware: onboards surf clubs, takes bookings, notifies clubs.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "reset": "node src/scripts/reset.js",
    "seed": "node src/scripts/reset.js --demo",
    "import:places": "node src/scripts/import-places.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
