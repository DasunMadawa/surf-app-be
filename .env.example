# Copy to server/.env and fill in.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:root@localhost:5433/stara?schema=public"

# Google Maps Platform key with "Places API (New)" enabled. Server-side only — never put it in the client.
GOOGLE_MAPS_API_KEY=

# ─── Places API cost controls ───────────────────────────────
# Maximum API requests per minute (default 30). Lower = safer spend, higher = faster imports.
PLACES_RATE_LIMIT=30

# Seconds to cache search results in memory (default 3600). Set 0 to disable.
PLACES_CACHE_TTL=3600

# "basic" = cheap fields only (no phone/website/photos/reviews).
# "full"  = all fields including contact, photos, reviews (higher billing SKU).
PLACES_FIELD_TIER=full

# demo  = start with the fictional demo clubs (default)
# empty = start with no clubs; fill with `npm run import:places` and real registrations
SEED_MODE=empty

ADMIN_KEY=change-me
APP_URL=http://localhost:5173
PORT=4000

# Real email (optional). Without SMTP, emails are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Stara <no-reply@stara.lk>
